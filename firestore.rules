rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // New learning data is accessible only through the verified backend Admin SDK.
    match /learningUsers/{document=**} {
      allow read, write: if false;
    }
    match /learningMigrations/{document=**} {
      allow read, write: if false;
    }
  }
}
