# Existing browser Firebase configuration (public project identifiers)
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=

# Backend only: same Firebase project as the browser
FIREBASE_PROJECT_ID=
# Absolute path to a service account JSON OUTSIDE this repository, or use workload identity/ADC
GOOGLE_APPLICATION_CREDENTIALS=
# For cross-project accounts, set this to FIREBASE_PROJECT_ID and grant Service Usage Consumer there.
GOOGLE_CLOUD_QUOTA_PROJECT=
PORT=3001
# Optional comma-separated trusted reverse-proxy IPs/CIDRs; leave blank for direct access.
TRUST_PROXY=
# Docker Compose only: production hostname, without a scheme or path.
DOMAIN=learnbyquiz.spiritedrobot.in
# Optional immutable release image tag for deployment/rollback.
APP_IMAGE=learnbyquiz:local
# Never prefix provider secrets with VITE_
QLOO_API_KEY=
# Hackathon keys work only on this host. Override for a separate production key.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Choose nvidia for the free development/testing endpoint, or openai for the existing adapter.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
# Model must support named function calls and reasoning_effort=none.
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Used only when LLM_PROVIDER=openai:
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Set an available model with Chat Completions function calling support
LLM_MODEL=
