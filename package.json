{
  "name": "react-quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/tests/*.test.js",
    "test:live": "node --test server/tests/qloo.live.js",
    "migrate": "node scripts/migrate.js",
    "test:browser": "playwright test",
    "test:firestore": "node --test --test-concurrency=1 server/tests/firestore.integration.js server/tests/firestore.rules.integration.js",
    "format:check": "prettier --check server scripts src/api/learning.js src/pages/Journey playwright.config.js tests/browser",
    "verify:live": "node scripts/verify-live.js",
    "test:live:qloo": "node --test server/tests/qloo.matrix.live.js",
    "test:emulator": "node scripts/test-emulator.js",
    "test:live:fullstack": "node --test server/tests/fullstack.live.js",
    "test:release": "node scripts/release-check.js",
    "test:live:all": "node scripts/release-check.js --live",
    "test:live:firebase": "node --test server/tests/firebase.live.js"
  },
  "dependencies": {
    "dayjs": "^1.11.7",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^8.5.2",
    "he": "^1.2.0",
    "helmet": "^8.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.8.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^4.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.13",
    "concurrently": "^9.2.5",
    "postcss": "^8.4.21",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.2.4",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
